PORT=8787
# Comma-separated list of allowed website origins (CORS)
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# Supabase (service role key stays on the server ONLY — never in the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enquiry notifications (any SMTP provider, e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=qadriglasslimited0@gmail.com
NOTIFY_FROM="Qadri Glass Website <no-reply@example.com>"

# Optional Cloudflare Turnstile secret for extra spam protection
TURNSTILE_SECRET=
